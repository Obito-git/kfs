      "seed": 947463421,
      "version": 2301,
      "versionNonce": 1991247465,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1735752485520,
      "link": null,
      "locked": false,
      "text": "\nContains only handler for Page Faults.\nIt will be fully implemented in KFS-4.\n\n\nFor keyboard, I have an infinite loop\nat the end of the Rust\nkernel function that checks\nfor keyboard interrupts.\n\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nContains only handler for Page Faults.\nIt will be fully implemented in KFS-4.\n\n\nFor keyboard, I have an infinite loop\nat the end of the Rust\nkernel function that checks\nfor keyboard interrupts.\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
