      "isDeleted": false,
      "boundElements": null,
      "updated": 1736102239710,
      "link": null,
      "locked": false,
      "text": "This approach is easy to implement and it \nworks fine on early stages. I used it only on\nthe beginning just to enable paging and prove\nit works. But this approach is too naive \nand I'll use Higher Half Kernel to be closer\nto the real kernel",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This approach is easy to implement and it \nworks fine on early stages. I used it only on\nthe beginning just to enable paging and prove\nit works. But this approach is too naive \nand I'll use Higher Half Kernel to be closer\nto the real kernel",
      "autoResize": true,
      "lineHeight": 1.25
    },
