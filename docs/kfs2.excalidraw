      "isDeleted": false,
      "boundElements": [],
      "updated": 1736026105425,
      "link": null,
      "locked": false,
      "text": "Flat memory model:\nAll segments cover the entire address space\nThe segments aren't used for memory size limits\nThey're mainly used for their permission bits \n    (code vs data, kernel vs user)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Flat memory model:\nAll segments cover the entire address space\nThe segments aren't used for memory size limits\nThey're mainly used for their permission bits \n    (code vs data, kernel vs user)",
      "autoResize": true,
      "lineHeight": 1.25
    },
