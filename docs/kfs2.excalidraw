    {
      "id": "fkEFZXrkNURA-nbaccV2Y",
      "type": "text",
      "x": 1722.535646036688,
      "y": 1539.186035208338,
      "width": 523.3499755859375,
      "height": 385,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
